{
  "name": "draftdock",
  "version": "0.2.1",
  "description": "Local-first multi-platform publishing workbench for WeChat, Xiaohongshu, X and Zhihu.",
  "main": "out/main/index.js",
  "type": "module",
  "author": "DraftDock contributors",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:win": "pnpm build && electron-builder --win nsis portable",
    "dist:dir": "pnpm build && electron-builder --dir"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "dompurify": "^3.2.6",
    "lucide-react": "^0.468.0",
    "marked": "^16.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-easy-crop": "^5.5.3",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.3",
    "twitter-text": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/sanitize-html": "^2.16.0",
    "@types/twitter-text": "^3.1.10",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^38.1.2",
    "electron-builder": "26.15.3",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.patchset.draftdock",
    "productName": "稿间 DraftDock",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "README.md",
      "LICENSE"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "DraftDock-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "DraftDock-Portable-${version}-${arch}.${ext}"
    }
  }
}
